{
  "name": "@openagenet/oan-discovery-embedding-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP embedding service for OAN Discovery Node semantic search.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
